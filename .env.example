# --- TriageGuard backend configuration ---

# Demo mode (offline fallback): returns pre-written pipeline outputs for the
# 3 demo scenarios instead of calling the LLM. FLIP THIS OFF to go live.
DEMO_MODE=true

# LLM (OpenAI-compatible endpoint). Only used when DEMO_MODE=false.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# Classifications below this confidence score require human approval.
CONFIDENCE_THRESHOLD=0.6

HOST=127.0.0.1
PORT=8000
